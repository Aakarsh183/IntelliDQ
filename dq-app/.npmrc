# Applies to every npm command run in dq-app - locally and in CI - so the dependency
# tree has the same shape everywhere. That matters because `npm ci` does not replay
# package-lock.json verbatim: it recomputes the tree and fails if the two disagree.
#
# The concrete problem this solves:
#   react-scripts@5.0.1 -> tailwindcss@3.4.19 -> postcss-load-config@6.0.1, which
#   declares an OPTIONAL peer dependency on yaml@^2.4.2. Current npm pulls resolvable
#   optional peers into the computed tree; the older npm that generated our committed
#   package-lock.json did not, so the lock has no yaml@2.x entry and `npm ci` aborts
#   with "Missing: yaml@2.9.0 from lock file".
#
# Ignoring peer dependencies when building the tree means that optional peer is never
# demanded, so the existing lock validates. Installed versions still come from the lock
# verbatim - this changes peer RESOLUTION, not what gets installed.
#
# Keeping it here rather than as a `npm ci --legacy-peer-deps` flag in ci.yml is
# deliberate: npm requires the same tree-shape flags for the install that writes the
# lock and the ci that reads it. In a workflow file it would only cover CI, and the next
# person to run a plain `npm install` locally would commit a lock CI then rejects.
#
# Corollary: this file and package-lock.json are now a matched pair. Deleting it means
# regenerating the lock without it, in the same commit - otherwise `npm ci` breaks again.
legacy-peer-deps=true
