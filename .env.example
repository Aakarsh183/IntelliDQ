# TEMPLATE ONLY - every value here must stay a placeholder.
#
# This file IS committed to git. Real credentials belong in backend/.env, which is
# gitignored (root .gitignore line 30, and that pattern covers .env at any depth).
# Anything typed to the right of an "=" below gets pushed to Aakarsh183/IntelliDQ and
# stays in the history even after a later commit removes it.
#
# Set up a working environment:
#   cp .env.example backend/.env      # then fill in real values there
#
# Why these are required at all: backend/main_app.py runs `client = GrokClient()` at
# module scope, and GrokClient.__init__ constructs AzureOpenAI(api_key=...,
# azure_endpoint=...). The openai SDK raises when either is missing, so the process -
# container or not - exits during import rather than at first request.

AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# Read by grok_client.py and column_resolver.py via load_dotenv(). Only the stale
# (commented-out) code paths call these, so they can be left blank.
GROK_API_KEY=
GROK_BASE_URL=

# NEVER put these in a frontend .env. Create React App inlines every REACT_APP_* value
# into the JavaScript bundle it ships, so an Azure key placed there is readable by
# anyone who opens the site. The frontend never needs Azure credentials - it only calls
# the backend, which holds them server-side.
